rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Institutions Directory
    match /institutions/{institutionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Academic Certificates (Issuing, verification, revocation status)
    match /certificates/{certificateId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Universal Documents Registry
    match /documents/{documentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Manual Verification Reviews Queue
    match /manual_reviews/{reviewId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Verification History & Public Transparency Logs
    match /verification_history/{verificationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Immutable System Audit Logs
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
